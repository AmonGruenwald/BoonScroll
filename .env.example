# Copy this file to .env and fill in your values

# --- AI provider (pick one) ---

# Option A: Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Option B: OpenRouter API key (openrouter.ai)
# When set, OpenRouter takes priority over ANTHROPIC_API_KEY.
OPENROUTER_API_KEY=
# Main model via OpenRouter (used for synthesis and fact generation)
OPENROUTER_MODEL=anthropic/claude-opus-4
# Cheap/fast model via OpenRouter (used for relevance filtering and topic grouping)
FAST_MODEL_OPENROUTER=google/gemini-flash-1.5

# If using Anthropic directly, the fast model used for filtering/grouping
FAST_MODEL_ANTHROPIC=claude-haiku-4-5-20251001

# How many hours back to consider news "current" (default 36)
NEWS_RECENCY_HOURS=36

# --- Feed settings ---

# How many feed items to show per user per day (default 12)
ITEMS_PER_USER=12
